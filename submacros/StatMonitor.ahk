; ▰▰▰▰▰
; MAIN LOOP
; ▰▰▰▰▰

; startup finished, set start time
start_time := A_Now
status_changes[A_Min*60+A_Sec] := 0

; set emergency switches in case of time error
last_honey := last_report := time := 0
; hour of the last scheduled report (YYYYMMDDHH); a report is due whenever the clock moves into a new hour
last_hour := SubStr(A_Now, 1, 10)

; indefinite loop of detection and reporting
Loop
{
	; obtain current time and wait until next 6-second interval
	DllCall("GetSystemTimeAsFileTime", "int64p", &time)
	Sleep (60000000-Mod(time, 60000000))//10000 + 100
	time_value := (60*A_Min+A_Sec)//6

	; detect buffs every 6 seconds
	DetectBuffs()

	; quick honey read every 12 s between the minute readings (digit pictures only, no OCR, so it never slows
	; the buff checks); these cross-check the next minute reading
	if ((ocr_enabled = 1) && (Mod(time_value, 2) = 0) && (Mod(time_value, 10) != 0))
		if (v := HoneyQuickRead())
			honey_samples.Push([A_TickCount, v])

	; detect honey every minute if ocr is enabled
	if ((ocr_enabled = 1) && ((Mod(time_value, 10) = 0) || (last_honey && time > last_honey + 580000000)))
	{
		DetectHoney()
		DllCall("GetSystemTimeAsFileTime", "int64p", &time)
		last_honey := time
	}

	; send report every hour, or on request (?hr). "Every hour" means: the clock is in a new hour since the last
	; scheduled report. The old check needed the 6-second tick at exactly hh:00:00-05, which was skipped whenever
	; the previous check (buffs + honey reading) took longer than 6 seconds, and then that hour had no report
	if (force_report || (SubStr(A_Now, 1, 10) != last_hour))
	{
		report_forced := force_report, force_report := 0
		if !report_forced
			last_hour := SubStr(A_Now, 1, 10)
		SendHourlyReport()
		DllCall("GetSystemTimeAsFileTime", "int64p", &time)
		last_report := time
	}
}



