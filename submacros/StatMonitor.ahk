/********************************************************************************************
* @description: detects buffs in BSS and updates the relevant arrays with current buff values
* @returns: (string) list of buffs and their values (buff:value) delimited by new lines
* @author SP
********************************************************************************************/
DetectBuffs()
{
	global buff_values, buff_characters, buff_bitmaps

	; set time value
	time_value := (60*A_Min+A_Sec)//6
	i := (time_value = 0) ? 600 : time_value

	; check roblox window exists
	hwnd := GetRobloxHWND()
	GetRobloxClientPos(hwnd), offsetY := GetYOffset(hwnd)
	if !(windowHeight >= 500)
	{
		for k,v in buff_values
		{
			v[i] := 0
			str .= k ":" 0 "`n"
		}
		return str
	}
    
    



	; create bitmap for buffs
	pBMArea := Gdip_BitmapFromScreen(windowX "|" windowY+offsetY+30 "|" windowWidth "|50")
	BuffStackWords(0, 1) ; new screenshot, so forget the previous OCR read of the stack numbers

	buff_colors := Map()
	buff_colors["pinetree"]   := 0x257039 ; measured from a real Pine Tree boost icon (was 0x206F2C, which missed it)						
	buff_colors["blueflower"] := 0x1558DF   
	buff_colors["bamboo"]      := 0x51C362
	buff_colors["snowflake"]   := 0xC7DCE1

	secondary_colors := Map()
	secondary_colors["pinetree"]   := 0x714C1C
	secondary_colors["blueflower"] := 0xFFE23D
	secondary_colors["bamboo"]      := 0x5D864B
	secondary_colors["snowflake"]   := 0x36424F

	for v in ["snowflake","babylove","guiding","pinetree","blueflower","bamboo"] {
	    if (v="snowflake" || v="pinetree" || v="blueflower" || v="bamboo") {
	        ; field boosts and snowflake: searched in this script's own screenshot of the buff bar (follows the
	        ; Roblox window and GUI offset, whole width) instead of fixed screen coordinates 0-900 px, and a buff
	        ; only counts when an icon-sized patch has many pixels of its main colour plus some of its second
	        ; colour (a few stray pixels of the same green or blue elsewhere no longer count)
	        buff_values[v][i] := (v = "snowflake")
	            ? FieldBuffPresent(pBMArea, buff_colors[v], secondary_colors[v], 5, 7, 30)
	            : FieldBuffPresent(pBMArea, buff_colors[v], secondary_colors[v], 8, 10, 20)
	    } else {
	        ; Your existing Gdip logic for babylove and guiding
	        buff_values[v][i] := (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBM" v], , , 30, , , (InStr(v,"mark") || v="guiding") ? 20 : 0, , 7) = 1)
	    }
	}

	; basic on/off
	for v in ["jbshare","babylove","festivemark","guiding","fieldcorruption","cloudbuff"]   {
	    if (v == "fieldcorruption") {
			temp_val := (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBM" v], , , , , , 30) = 1)
						buff_values[v][i] := temp_val
		} else if (v == "snowflake") {
				;check that: science buff visible and e button not visible (buffs not obscured)
				if ((Gdip_ImageSearch(pBMArea, bitmaps["science"]) = 1) && (Gdip_ImageSearch(pBMArea, bitmaps["e_button"]) = 0)) {
					buff_values[v][i] := (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBMSnowflake"], &pos, , 20, , , , , 7) = 1)
				} else {
					buff_values[v][i] := 0
				}
						} else {
		buff_values[v][i] := (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBM" v], , , 30, , , InStr(v, "mark") ? 6 : (v = "guiding") ? 10 : 0, , 7) = 1)
		}
	}
	for v in ["cloudbuff"]
		buff_values[v][i] := (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBM" v], , , , , , 30) = 1)


	; bear morphs
	buff_values["bear"][i] := 0
	for v in ["Brown","Black","Panda","Polar","Gummy","Science","Mother"]
	{
		if (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBMBear" v], , , 43, , 45, 8, , 2) = 1)
		{
			buff_values["bear"][i] := 1
			break
		}
	}

	; basic x1-x10
	for v in ["focus","bombcombo","balloonaura","clock","honeymark","pollenmark","reindeerfetch"]
	{
		if (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBM" v], &list, , InStr(v, "mark") ? 20 : 30, , 50, InStr(v, "mark") ? 6 : 0, , 7) != 1)
		{
			buff_values[v][i] := 0
			continue
		}

		x := SubStr(list, 1, InStr(list, ",")-1)

		buff_values[v][i] := ReadBuffStack(pBMArea, x-20, 15, x, 50, 10, v)
	}

	; mondo
	for v in ["mondo"]
	{
		if (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBM" v], &list, , 20, , 46, 21, , 7) != 1)
		{
			buff_values[v][i] := 0
			continue
		}

		x := SubStr(list, 1, InStr(list, ",")-1)

		buff_values[v][i] := ReadBuffStack(pBMArea, x+16, 20, x+36, 46, 10, v)
	}

	; melody / haste
	x := 0
	Loop 3 ; melody, haste, coconut haste
	{
		if (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBMHaste"], &list, x, 30, , , , , 6) != 1)
			break

		x := SubStr(list, 1, InStr(list, ",")-1)

		if ((s := Gdip_ImageSearch(pBMArea, buff_bitmaps["pBMMelody"], , x+2, 15, x+34, 40, 12)) != 1)
		{
			if !buff_values["haste"].Has(i)
			{
				buff_values["haste"][i] := ReadBuffStack(pBMArea, x+6, 15, x+44, 50, 10, "haste")
			}
		}
		else if (s = 1)
			buff_values["melody"][i] := 1

		x += 44
	}
	for v in ["melody","haste"]
		if !buff_values[v].Has(i)
			buff_values[v][i] := 0

	; colour boost x1-x10
	x := windowWidth
	Loop 3
	{
		if (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBMBoost"], &list, , 30, x, , , , 7) != 1)
			break

		x := SubStr(list, 1, InStr(list, ",")-1)
		y := SubStr(list, InStr(list, ",")+1)

		; obtain colour of boost buff
		pBMPxRed := Gdip_CreateBitmap(1,2), pBMPxBlue := Gdip_CreateBitmap(1,2)
		pGRed := Gdip_GraphicsFromImage(pBMPxRed), pGBlue := Gdip_GraphicsFromImage(pBMPxBlue)
		Gdip_GraphicsClear(pGRed, 0xffe46156), Gdip_GraphicsClear(pGBlue, 0xff56a4e4)
		Gdip_DeleteGraphics(pGRed), Gdip_DeleteGraphics(pGBlue)
		v := (Gdip_ImageSearch(pBMArea, pBMPxRed, , x-30, 15, x-4, 34, 20, , , 2) = 2) ? "redboost"
			: (Gdip_ImageSearch(pBMArea, pBMPxBlue, , x-30, 15, x-4, 34, 20, , , 2) = 2) ? "blueboost"
			: "whiteboost"
		Gdip_DisposeImage(pBMPxRed), Gdip_DisposeImage(pBMPxBlue)

		; find stack number
		buff_values[v][i] := ReadBuffStack(pBMArea, x-20, 15, x, 50, 10, v)

		x -= 2*y-53 ; take away width of buff square to prevent duplication
	}
	for v in ["redboost","blueboost","whiteboost"]
		if !buff_values[v].Has(i)
			buff_values[v][i] := 0

	; 2 digit
	for v in ["blessing","inspire"]
	{
		if (v = "blessing") && (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBMBlessingx100"], , , 20, , , 21, , 6)=1)
		{
			buff_values["blessing"][i] := "100"
			continue
		}
		if (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBM" v], &list, , 20, , , (v = "blessing") ? 21 : 0, , (v = "blessing") ? 6 : 7) != 1)
		{
			buff_values[v][i] := 0
			continue
		}

		x := SubStr(list, 1, InStr(list, ",")-1)

		if (nm_OCR_Language() != "") ; OCR available: read the number directly (the digit images below are from the old font)
		{
			buff_values[v][i] := ReadBuffStack(pBMArea, ((v = "blessing") ? x+8 : x-20), 15, ((v = "blessing") ? x+36 : x), 50, (v = "inspire") ? 50 : 100, v)
			continue
		}

		(digits := Map()).Default := ""

		Loop 10
		{
			n := 10-A_Index
			if ((n = 1) || (n = 3))
				continue
			Gdip_ImageSearch(pBMArea, buff_characters[n], &list:="", ((v = "blessing") ? x+8 : x-20), 15, ((v = "blessing") ? x+36 : x), 50, 1, , 5, 5, , "`n")
			Loop Parse list, "`n"
				if (A_Index & 1)
					digits[Integer(A_LoopField)] := n
		}

		for m,n in [1,3]
		{
			Gdip_ImageSearch(pBMArea, buff_characters[n], &list:="", ((v = "blessing") ? x+8 : x-20), 15, ((v = "blessing") ? x+36 : x), 50, 1, , 5, 5, , "`n")
			Loop Parse list, "`n"
			{
				if (A_Index & 1)
				{
					if (((n = 1) && (digits[A_LoopField - 5] = 4)) || ((n = 3) && (digits[A_LoopField - 1] = 8)))
						continue
					digits[Integer(A_LoopField)] := n
				}
			}
		}

		num := ""
		for x,y in digits
			num .= y

		buff_values[v][i] := num ? Min(num, (v = "inspire" ? 50 : 100)) : 1
	}

	; scaled
	for v in ["bloat","comforting","motivating","satisfying","refreshing","invigorating"]
	{
		if (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBM" v], &list, , 30, , , , , 6) != 1)
		{
			buff_values[v][i] := 0
			continue
		}

		x := SubStr(list, 1, InStr(list, ",")-1)

		if (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBM" v], &list, x, 6, x+38, 44) != 1)
		{
			buff_values[v][i] := 0
			continue
		}

		y := SubStr(list, InStr(list, ",")+1)

		buff_values[v][i] := String(Round(Min((44 - y) / 38, 1) * ((v = "bloat") ? 5 : 100) + ((v = "bloat") ? 1 : 0), (v = "bloat") ? 2 : 0))
	}

	; tide
	for v in ["tideblessing"]
	{
		if (Gdip_ImageSearch(pBMArea, buff_bitmaps["pBM" v], &list, , 30, , , , , 6) != 1)
			continue

		x := SubStr(list, 1, InStr(list, ",")-1)

		pBM := Gdip_CreateBitmap(36, 1), Gdip_SetPixel(pBM, 0, 0, 0xff91c2fd), Gdip_SetPixel(pBM, 35, 0, 0xff91c2fd)

		s := Gdip_ImageSearch(pBMArea, pBM, &list, x-16, 6, x+36, 44)
		Gdip_DisposeImage(pBM)
		if (s != 1)
			continue

		y := SubStr(list, InStr(list, ",")+1)
		buff_values[v][i] := String(Round(1.01 + 0.19 * (44.3 - y) / 38, 2))
	}

	; form string
	str := ""
	for k,v in buff_values
		str .= k ":" (v.Has(i) ? v[i] : 0) "`n"

	; clean up and return
	Gdip_DisposeImage(pBMArea)
	return str
}

/********************************************************************************************
* @description: is a buff icon with these colours on the buff bar? Finds every pixel of the main colour
*   (one fast search), groups them into icon-wide columns, and accepts a column with at least minCount of
*   them when the same patch also has a few pixels of the second colour
********************************************************************************************/
FieldBuffPresent(pBMArea, primary, secondary, varP, varS, minCount := 20)
{
	static dots := Map()
	for c in [primary, secondary]
		if !dots.Has(c)
		{
			dots[c] := Gdip_CreateBitmap(1, 1), G := Gdip_GraphicsFromImage(dots[c])
			Gdip_GraphicsClear(G, 0xFF000000 | c), Gdip_DeleteGraphics(G)
		}
	w := Gdip_GetImageWidth(pBMArea), h := Gdip_GetImageHeight(pBMArea)
	if (Gdip_ImageSearch(pBMArea, dots[primary], &list, 0, 8, w, h, varP, , 1, 800) < minCount)
		return 0
	bins := Map()
	Loop Parse list, "`n"
	{
		if (A_LoopField = "")
			continue
		b := Integer(StrSplit(A_LoopField, ",")[1]) // 20
		bins[b] := (bins.Has(b) ? bins[b] : 0) + 1
	}
	for b, c in bins
	{
		if (c + (bins.Has(b+1) ? bins[b+1] : 0) < minCount) ; an icon spans about two 20 px columns
			continue
		if (Gdip_ImageSearch(pBMArea, dots[secondary], , Max(0, b*20 - 20), 8, Min(w, b*20 + 60), h, varS, , 1, 6) >= 4)
			return 1
	}
	return 0
}

/********************************************************************************************
* @description: reads a buff's stack number (x2-x10, or larger for Blessing/Inspire) inside the
*   given area of the buff bar screenshot. Uses OCR, because the buff_characters digit images were
*   captured from the old Roblox font and no longer match; falls back to them only if OCR is unavailable.
*   If OCR can't find a number this pass, the buff's last real reading is kept for up to two passes
*   (~12 s) before dropping to x1, so one missed read doesn't show as a spike down to x1 on the graph.
* @returns: the stack number, or 1 if none is shown (BSS shows no number at x1)
********************************************************************************************/
ReadBuffStack(pBMArea, x1, y1, x2, y2, maxVal := 10, key := "")
{
	global buff_characters
	static lastRead := Map()
	if (nm_OCR_Language() = "")
	{
		Loop 9
			if (Gdip_ImageSearch(pBMArea, buff_characters[10-A_Index], , x1, y1, x2, y2) = 1)
				return (A_Index = 9) ? 10 : 10 - A_Index
		return 1
	}
	; 0. picture match for "10"; 1. the shared read of the whole buff bar; 2. a close-up read of just this buff's number area
	if (maxVal = 10) && nm_OCR_HasX10(pBMArea, x1, y1, x2, y2)
		n := 10
	else if (maxVal = 10) && ((n := nm_OCR_BuffDigit(pBMArea, x1, y1, x2, y2)) != "")
		n := n
	else if (maxVal = 10) && ((n := BuffLearnedMatch(pBMArea, key, x1, y1, x2, y2)) != "")
		n := n ; digit pictures this PC has learned (see BuffLearnSample)
	else if ((n := StackFromWords(BuffStackWords(pBMArea), x1, y1, x2, y2, maxVal, &box)) = "")
		n := StackFromCrop(pBMArea, x1, y1, x2, y2, maxVal)
	else if (maxVal = 10) && (key != "") && !BuffLearnedHas(key, n)
	{
		; learning: no picture knows this number yet, so confirm the whole-bar OCR read with the separate close-up
		; read of the SAME screenshot (no time passes, so fast-changing stacks don't matter). If both agree, the
		; look of this number is collected; it is only trusted after 3 alike confirmations
		if (StackFromCrop(pBMArea, x1, y1, x2, y2, maxVal) = n)
			BuffLearnSample(pBMArea, key, n, box)
	}
	if (n != "")
	{
		if (key != "")
			lastRead[key] := [n, A_TickCount]
		return n
	}
	if (key != "") && lastRead.Has(key) && (A_TickCount - lastRead[key][2] <= 13000)
		return lastRead[key][1]
	return 1
}

;  ---------------------------------------------------------------------------------------------------
;  SELF-LEARNING BUFF STACK PICTURES
;  When OCR reads a stack number that no picture knows yet, and two independent OCR reads of the same
;  screenshot agree (whole buff bar + close-up), the number's look is cut out: its white fill and dark outline
;  are kept, the icon behind it is ignored (magenta). Once the same look has been confirmed 3 times for the
;  same buff and number it is saved to settings\buff_digits_learned\<buff>_<number>_<n>.png (up to 3 per
;  number) and from then on matched like the built-in pictures. If a look ever matches two different numbers
;  it is thrown away. So after a font change, or on a PC that draws the icons differently, stack reading
;  recovers by itself. Log: tools\OCR_debug\buff_learn_log.txt
;  ---------------------------------------------------------------------------------------------------

; Map buff -> Map number -> [bitmaps] of trusted learned pictures (loaded once from disk)
BuffLearned()
{
	static learned := 0
	if !IsObject(learned)
	{
		learned := Map()
		Loop Files A_WorkingDir "\settings\buff_digits_learned\*.png"
		{
			if !RegExMatch(A_LoopFileName, "^([a-z]+)_(\d+)_\d+\.png$", &m)
				continue
			if !(pBM := Gdip_CreateBitmapFromFile(A_LoopFileFullPath))
				continue
			if !learned.Has(m[1])
				learned[m[1]] := Map()
			if !learned[m[1]].Has(Integer(m[2]))
				learned[m[1]][Integer(m[2])] := []
			learned[m[1]][Integer(m[2])].Push(pBM)
		}
	}
	return learned
}

BuffLearnedHas(key, n) => BuffLearned().Has(key) && BuffLearned()[key].Has(n)

; stack number from this buff's learned pictures, or "" (also "" if pictures of two different numbers match)
BuffLearnedMatch(pBMArea, key, x1, y1, x2, y2)
{
	learned := BuffLearned()
	if (key = "") || !learned.Has(key)
		return ""
	w := Gdip_GetImageWidth(pBMArea), h := Gdip_GetImageHeight(pBMArea)
	found := ""
	for n, list in learned[key]
		for pT in list
			if (Gdip_ImageSearch(pBMArea, pT, , Max(0, x1 - 8), Max(0, y1 - 6), Min(w, x2 + 10), Min(h, y2 + 4), 70, 0xFF00FF) = 1)
			{
				if (found != "") && (found != n)
					return ""
				found := n
				break
			}
	return found
}

; Cut-out of a stack number: white fill -> white, dark outline -> black, everything else (the icon) -> magenta
; (ignored when matching). 0 if it doesn't contain enough of both to be a number
BuffDigitMask(pBM, x, y, w, h)
{
	pM := Gdip_CloneBitmapArea(pBM, x, y, w, h)
	white := 0, dark := 0
	Loop h
	{
		py := A_Index - 1
		Loop w
		{
			px := A_Index - 1, c := Gdip_GetPixel(pM, px, py)
			r := (c >> 16) & 255, g := (c >> 8) & 255, b := c & 255
			if (Min(r, g, b) >= 190)
				Gdip_SetPixel(pM, px, py, 0xFFFFFFFF), white++
			else if (Max(r, g, b) <= 70)
				Gdip_SetPixel(pM, px, py, 0xFF000000), dark++
			else
				Gdip_SetPixel(pM, px, py, 0xFFFF00FF)
		}
	}
	if (white < 15) || (dark < 10)
	{
		Gdip_DisposeImage(pM)
		return 0
	}
	return pM
}

; two cut-outs show the same thing (allowing a 1 px shift either way)
BuffDigitAlike(pA, pB)
{
	for pair in [[pA, pB], [pB, pA]]
	{
		big := pair[1], small := pair[2]
		sw := Gdip_GetImageWidth(small) - 2, sh := Gdip_GetImageHeight(small) - 2
		if (sw < 3) || (sh < 3) || (sw > Gdip_GetImageWidth(big)) || (sh > Gdip_GetImageHeight(big))
			continue
		pInner := Gdip_CloneBitmapArea(small, 1, 1, sw, sh)
		r := Gdip_ImageSearch(big, pInner, , , , , , 40, 0xFF00FF)
		Gdip_DisposeImage(pInner)
		if (r = 1)
			return 1
	}
	return 0
}

BuffLearnLog(msg)
{
	try FileAppend FormatTime(, "yyyy-MM-dd HH:mm:ss") "  " msg "`n", nm_OCR_RootDir() "\tools\OCR_debug\buff_learn_log.txt"
}

; collects one OCR-confirmed look of buff `key` showing number `n` (box = the OCR word's position)
BuffLearnSample(pBMArea, key, n, box)
{
	static pending := Map() ; "key|n" -> [[cut-out, confirmations], ...]
	if !RegExMatch(key, "^[a-z]+$")
		return
	w := Gdip_GetImageWidth(pBMArea), h := Gdip_GetImageHeight(pBMArea)
	bx := Max(0, Round(box.x) - 1), by := Max(0, Round(box.y) - 1)
	bw := Min(w - bx, Round(box.w) + 2), bh := Min(h - by, Round(box.h) + 2)
	if (bw < 5) || (bh < 6) || (bw > 40) || (bh > 30)
		return
	if !(pS := BuffDigitMask(pBMArea, bx, by, bw, bh))
		return
	id := key "|" n
	if !pending.Has(id)
		pending[id] := []
	for i, c in pending[id]
	{
		if !BuffDigitAlike(c[1], pS)
			continue
		Gdip_DisposeImage(pS)
		c[2] += 1
		if (c[2] >= 3)
		{
			pending[id].RemoveAt(i)
			BuffLearnPromote(key, n, c[1])
		}
		return
	}
	if (pending[id].Length >= 6) ; keep only the newest looks while none has 3 confirmations
		Gdip_DisposeImage(pending[id].RemoveAt(1)[1])
	pending[id].Push([pS, 1])
}

; a look confirmed 3 times becomes a trusted picture, unless it looks like a different number's picture
BuffLearnPromote(key, n, pT)
{
	learned := BuffLearned()
	dir := A_WorkingDir "\settings\buff_digits_learned"
	if learned.Has(key)
		for m, list in learned[key]
		{
			if (m = n)
				continue
			for pOther in list
				if BuffDigitAlike(pOther, pT)
				{
					; the same look was confirmed as two different numbers: trust neither
					for pX in list
						Gdip_DisposeImage(pX)
					learned[key].Delete(m)
					Loop Files dir "\" key "_" m "_*.png"
						try FileDelete A_LoopFileFullPath
					Gdip_DisposeImage(pT)
					BuffLearnLog(key " x" n " looks like x" m ": both thrown away")
					return
				}
		}
	if !learned.Has(key)
		learned[key] := Map()
	if !learned[key].Has(n)
		learned[key][n] := []
	if (learned[key][n].Length >= 3)
	{
		Gdip_DisposeImage(pT)
		return
	}
	try DirCreate dir
	k := 1
	while FileExist(dir "\" key "_" n "_" k ".png")
		k++
	try Gdip_SaveBitmapToFile(pT, dir "\" key "_" n "_" k ".png")
	learned[key][n].Push(pT)
	BuffLearnLog("learned " key " x" n " (picture " k ")")
}

; picks the stack number out of OCR words whose centre lies in the area; prefers "x5"-style tokens
StackFromWords(words, x1, y1, x2, y2, maxVal, &box?)
{
	for pass in [1, 2]
	{
		for word in words
		{
			cx := word.x + word.w/2, cy := word.y + word.h/2
			if (cx < x1 - 6 || cx > x2 + 6 || cy < y1 - 6 || cy > y2 + 6)
				continue
			hasX := RegExMatch(word.text, "i)^[x×*]")
			if ((pass = 1) != !!hasX) || !RegExMatch(word.text, "i)^[x×*]?[0-9OoIlS|B]{1,3}$")
				continue
			t := RegExReplace(word.text, "i)^[x×*]")
			t := StrReplace(StrReplace(StrReplace(t, "O", "0"), "S", "5"), "B", "8") ; common OCR digit mix-ups
			t := RegExReplace(t, "[Il|]", "1")
			if IsInteger(t) && (t >= 2) && (t <= maxVal)
			{
				box := word
				return Integer(t)
			}
		}
	}
	return ""
}

; close-up OCR of one buff's number area: cropped, placed on a larger dark canvas (OCR reads tiny
; isolated images badly) and read upscaled, normal and inverted
StackFromCrop(pBMArea, x1, y1, x2, y2, maxVal)
{
	w := Gdip_GetImageWidth(pBMArea), h := Gdip_GetImageHeight(pBMArea)
	cx1 := Max(0, x1 - 10), cy1 := Max(0, y1 - 6), cx2 := Min(w, x2 + 10), cy2 := Min(h, y2 + 4)
	cw := cx2 - cx1, ch := cy2 - cy1
	if (cw < 4 || ch < 4)
		return ""
	pCanvas := Gdip_CreateBitmap(cw + 80, ch + 40), G := Gdip_GraphicsFromImage(pCanvas)
	Gdip_GraphicsClear(G, 0xff202020)
	Gdip_DrawImage(G, pBMArea, 40, 20, cw, ch, cx1, cy1, cw, ch)
	Gdip_DeleteGraphics(G)
	n := ""
	for invert in [0, 1]
	{
		if !(result := nm_OCR_FromBitmap(pCanvas, 5, invert))
			break
		words := []
		for word in result.Words ; back to pBMArea coordinates
			words.Push({text: word.Text, x: word.x - 40 + cx1, y: word.y - 20 + cy1, w: word.w, h: word.h})
		if ((n := StackFromWords(words, x1, y1, x2, y2, maxVal)) != "")
			break
	}
	Gdip_DisposeImage(pCanvas)
	return n
}

/********************************************************************************************
* @description: OCR words of the buff bar screenshot, read once per DetectBuffs pass and only when
*   a stack number is actually needed. The bar is read in overlapping chunks so each can be upscaled,
*   in normal and inverted colours (white numbers on bright icons read better one way or the other).
* @returns: array of {text, x, y, w, h} in pBMArea coordinates
********************************************************************************************/
BuffStackWords(pBMArea, reset := 0)
{
	static words := 0
	if reset
	{
		words := 0
		return
	}
	if IsObject(words)
		return words
	words := []
	w := Gdip_GetImageWidth(pBMArea), h := Gdip_GetImageHeight(pBMArea)
	x0 := 0
	Loop
	{
		cw := Min(640, w - x0)
		if (cw < 20)
			break
		pPart := Gdip_CloneBitmapArea(pBMArea, x0, 0, cw, h)
		for invert in [0, 1]
			if (result := nm_OCR_FromBitmap(pPart, 3, invert))
				for word in result.Words
					words.Push({text: word.Text, x: word.x + x0, y: word.y, w: word.w, h: word.h})
		Gdip_DisposeImage(pPart)
		if (x0 + cw >= w)
			break
		x0 += cw - 40 ; overlap so a number on a chunk edge is still read whole
	}
	return words
}

/********************************************************************
* @description: uses OCR to detect the current honey value in BSS
* @returns: (string) current honey value or (integer) 0 on failure
* @note function is a WIP, and OCR readings are not 100% reliable!
* @author SP
********************************************************************/
DetectHoney()
{
	global honey_values, start_honey, start_time, ocr_language

	; check roblox window exists
	hwnd := GetRobloxHWND()
	GetRobloxClientPos(hwnd), offsetY := GetYOffset(hwnd)
	if !(windowHeight >= 500)
		return 0

	; read the honey counter with OCR word positions: find the "Honey" label and take the number to its right.
	; The area is taller than the counter so a GUI offset a few pixels off (e.g. after the Roblox font change)
	; can't cut the digits in half, which made the old fixed-box read return things like "4".
	current_honey := ReadHoneyCounter(windowX, windowY, windowWidth, offsetY)

	; Checks, so one misread can't skew the graph or the totals, while real big jumps are kept:
	; - the session's first reading (it becomes the start honey) is only kept if a second read agrees
	; - a reading that jumps further than any real change seen recently (or drops) is read again and only kept if
	;   two reads agree. A reading confirmed like this is real (e.g. the first balloon convert after you spent most
	;   of your honey before starting, which can be 10x your total), so the ballpark check below doesn't apply
	; - an unconfirmed reading more than double / less than half the last one needs the next minute to agree
	static lastGood := 0, pending := 0, lastGoodTick := 0, recentRates := [], liveSpent := 0
	confirmed := 0

	; cross-check with this minute's quick reads (every 12 s): the reading should sit within the range they
	; covered (plus a margin for honey still climbing during a convert). Agreeing with them counts as confirmed;
	; disagreeing gets the reading read again
	global honey_samples
	sampleCheck := 0, spread := 0
	if current_honey && (honey_samples.Length >= 3)
	{
		vals := []
		for smp in honey_samples
			vals.Push(smp[2])
		vals := HoneySorted(vals)
		if (vals.Length >= 4) ; one bad quick read can't stretch the range
			vals.RemoveAt(vals.Length), vals.RemoveAt(1)
		lo := vals[1], hi := vals[vals.Length], spread := hi - lo
		tol := Max(2000, spread, hi * 0.00002)
		sampleCheck := ((current_honey >= lo - tol) && (current_honey <= hi + tol)) ? 1 : -1
		try FileAppend FormatTime(, "HH:mm:ss") "  cross-check with " honey_samples.Length " quick reads (" lo "-" hi "): " (sampleCheck = 1 ? "agrees" : "disagrees, rechecking") "`n", nm_OCR_RootDir() "\tools\OCR_debug\honey_log.txt"
	}
	honey_samples := []

	if current_honey && !lastGood
	{
		if (sampleCheck = 1)
			confirmed := 1
		else
		{
			current_honey := HoneyConfirm(current_honey, current_honey, windowX, windowY, windowWidth, offsetY, Max(2000, current_honey * 0.002, spread))
			confirmed := (current_honey != 0)
		}
	}
	else if current_honey && (sampleCheck = 1)
		confirmed := 1
	else if current_honey && (sampleCheck = -1)
	{
		current_honey := HoneyConfirm(current_honey, lastGood, windowX, windowY, windowWidth, offsetY, Max(2000, spread))
		confirmed := (current_honey != 0)
	}
	else if current_honey
	{
		mins := Max(1, (A_TickCount - lastGoodTick) / 60000)
		maxRate := 0
		for r in recentRates
			maxRate := Max(maxRate, r)
		floorRate := Max(lastGood * 0.0002, 2000)
		change := current_honey - lastGood
		if (change > Max(maxRate * 3, floorRate) * mins) || (change < -Max(maxRate, floorRate))
		{
			current_honey := HoneyConfirm(current_honey, lastGood, windowX, windowY, windowWidth, offsetY, Max(maxRate, 2000))
			confirmed := (current_honey != 0)
		}
	}

	if current_honey && lastGood && !confirmed && ((current_honey > lastGood*2) || (current_honey < lastGood*0.5))
	{
		if pending && (current_honey <= pending*2) && (current_honey >= pending*0.5)
			pending := 0 ; two minutes agree: it's real
		else
			pending := current_honey, current_honey := 0 ; skip this minute
	}

	if current_honey
	{
		if lastGood
		{
			global honey_read_source, honey_read_digits
			if (honey_read_source = "ocr") && !confirmed ; OCR's reading fits the previous one: learn its digits
				HoneyLearn(honey_read_digits)
			recentRates.Push(Abs(current_honey - lastGood) / Max(1, (A_TickCount - lastGoodTick) / 60000))
			if (recentRates.Length > 30)
				recentRates.RemoveAt(1)
			; honey spent (shops, items...) isn't lost income: every drop between accepted readings is added back
			if (current_honey < lastGood)
				liveSpent += lastGood - current_honey
		}
		lastGood := current_honey, pending := 0, lastGoodTick := A_TickCount
	}

	; update honey values array and write values to ini
	index := (A_Min = "00") ? 60 : Integer(A_Min)
	if current_honey
	{
		honey_values[index] := current_honey
		; the session starts from the first (confirmed) reading. It used to be the median of the first 5 readings,
		; which cut the first convert out of Session Honey when it happened in the first few minutes
		; (IsSet: during the startup read itself start_honey doesn't exist yet, and reading it would throw)
		if (!IsSet(start_honey) || !start_honey)
			start_honey := current_honey
		if (FileExist("settings\nm_config.ini") && IsSet(start_time))
		{
			session_time := DateDiff(A_Now, start_time, "S")
			session_total := current_honey - start_honey + liveSpent
			try IniWrite FormatNumber(session_total), "settings\nm_config.ini", "Status", "SessionTotalHoney"
			try IniWrite FormatNumber(session_total*3600.0/session_time), "settings\nm_config.ini", "Status", "HoneyAverage"
		}
		return current_honey
	}
	else
		return 0
}

/********************************************************************************************************
* @description: a honey reading that changed suspiciously much is read up to 2 more times; returns a value two
*   reads agree on (honey can move a little between reads, e.g. while converting), or 0 to skip this minute.
*   Every recheck is written to tools\OCR_debug\honey_log.txt
********************************************************************************************************/
HoneyConfirm(first, last, winX, winY, winW, offsetY, tol)
{
	; While converting balloons honey climbs very fast, so two reads under a second apart can differ by more than
	; the usual tolerance. They still differ by only a few % of the change being checked, while a misread digit
	; differs from the real value by about the whole change, so allow 5% of the change too
	tol := Max(tol, Abs(first - last) * 0.05)
	reads := [first], result := 0
	Loop 2
	{
		Sleep 400
		if (v := ReadHoneyCounter(winX, winY, winW, offsetY))
			reads.Push(v)
		for i, a in reads
			for j, b in reads
				if (j > i) && (Abs(a - b) <= tol)
				{
					result := Max(a, b)
					break 3
				}
	}
	try
	{
		str := ""
		for v in reads
			str .= (A_Index > 1 ? ", " : "") v
		FileOpen(nm_OCR_RootDir() "\tools\OCR_debug\honey_log.txt", "a").Write(FormatTime(, "yyyy-MM-dd HH:mm:ss") " recheck (last good " last "): reads " str " -> " (result ? "kept " result : "skipped minute") "`n")
	}
	return result
}

; copy of an array of numbers, sorted smallest first
HoneySorted(arr)
{
	sorted := []
	for v in arr
	{
		i := sorted.Length + 1
		while (i > 1 && sorted[i-1] > v)
			i--
		sorted.InsertAt(i, v)
	}
	return sorted
}

; median of an array of numbers (0 for an empty array)
HoneyMedian(arr)
{
	if !arr.Length
		return 0
	sorted := HoneySorted(arr)
	return sorted[(sorted.Length + 1) // 2]
}

; Quick honey read for the 12-second cross-check samples: the digit pictures only, at the remembered "Honey"
; label position (no OCR at all), so it is cheap. Returns 0 when the pictures can't read it
HoneyQuickRead()
{
	if !(hwnd := GetRobloxHWND())
		return 0
	GetRobloxClientPos(hwnd), offsetY := GetYOffset(hwnd)
	if !(windowHeight >= 500)
		return 0
	; same read area as ReadHoneyCounter, so the remembered label position fits
	x0 := Max(0, windowWidth//2 - 520), w := Min(530, windowWidth - x0)
	h := Min(170, Max(90, offsetY + 70))
	pBM := Gdip_BitmapFromScreen(windowX + x0 "|" windowY "|" w "|" h)
	digits := HoneyReadDigits(pBM, w, h, 1)
	Gdip_DisposeImage(pBM)
	if (digits = "")
		return 0
	return ((StrLen(digits) > 19) || (StrLen(digits) = 19 && StrCompare(digits, "9223372036854775807") > 0)) ? Float(digits) : Integer(digits)
}

/********************************************************************************************************
* @description: receives a report request from Status.ahk (?hr). Only sets a flag: the main loop sends the
*   report at its next 6-second tick, so the report is never built in the middle of a buff detection pass
********************************************************************************************************/
RequestReport(wParam, lParam, *)
{
	global force_report := 1
	return 0
}

/********************************************************************************************************
* @description: reads BSS's honey counter (top bar) many ways with OCR and returns the value that came up
*   most often (at least twice), or 0. Each read locates the "Honey" label and joins the number to its right.
*   If no value can be agreed on, the screenshot and every OCR reading are saved to tools\OCR_debug\honey_fail.*
********************************************************************************************************/
ReadHoneyCounter(winX, winY, winW, offsetY)
{
	; wide enough that the "Honey" label is inside even when the UI is drawn larger (display scaling)
	x0 := Max(0, winW//2 - 520), w := Min(530, winW - x0)
	; from the very top of the window down to below the counter, so a wrong GUI offset can't push the counter
	; out of the area (the "Honey" label is found by OCR wherever it is in here)
	y0 := 0, h := Min(170, Max(90, offsetY + 70))
	pBM := Gdip_BitmapFromScreen(winX + x0 "|" winY + y0 "|" w "|" h)

	; first choice: the counter's digits recognised from pictures of BSS's honey font (exact, no OCR guessing)
	global honey_read_source := "", honey_read_digits := ""
	if ((digits := HoneyReadDigits(pBM, w, h)) != "")
	{
		honey_read_source := "pictures", honey_read_digits := digits
		Gdip_DisposeImage(pBM)
		try {
			logPath := nm_OCR_RootDir() "\tools\OCR_debug\honey_log.txt"
			DirCreate nm_OCR_RootDir() "\tools\OCR_debug"
			if (FileExist(logPath) && FileGetSize(logPath) > 50000)
				FileDelete logPath
			FileAppend FormatTime(, "HH:mm:ss") "  " digits "  (digit pictures)`n", logPath
		}
		return ((StrLen(digits) > 19) || (StrLen(digits) = 19 && StrCompare(digits, "9223372036854775807") > 0)) ? Float(digits) : Integer(digits)
	}

	; second copy with the same darkening/contrast the original honey reader used, so white digits stand out
	pBMc := Gdip_CloneBitmapArea(pBM, 0, 0, w, h)
	if ((pEffect := Gdip_CreateEffect(5, -80, 30)) && !InStr(pEffect, "err"))
		Gdip_BitmapApplyEffect(pBMc, pEffect), Gdip_DisposeEffect(pEffect)

	; black-on-white versions: every pixel brighter than the threshold becomes black, the rest white. The
	; counter is white text on a dark bar, and OCR reads clean black text on white far more reliably
	variants := [[pBM, "plain", [2, 3, 4, 5], [0, 1]], [pBMc, "contrast", [2, 3, 4, 5], [0, 1]]]
	for threshold in [0.55, 0.7, 0.85]
		variants.Push([HoneyThreshold(pBM, threshold), "threshold " threshold, [3, 4], [0]])

	reads := [], readLog := ""
	; most reliable: a tight crop of just the number (found from the "Honey" label and the counter's yellow
	; digits), cleaned up and read on a white background. The counter bar is see-through, so hive cells and
	; their level numbers show behind the digits; the yellow filter removes them
	if (pTight := HoneyTightCrop(pBM, w, h))
	{
		for tv in [["tight yellow", HoneyYellow(pTight)], ["tight threshold 0.7", nm_OCR_Threshold(pTight, 0.7, 1)], ["tight threshold 0.6", nm_OCR_Threshold(pTight, 0.6, 1)]]
		{
			pPad := HoneyPad(tv[2])
			Gdip_DisposeImage(tv[2])
			for scale in [3, 4, 5]
			{
				if !(result := nm_OCR_FromBitmap(pPad, scale, 0))
					continue
				v := HoneyNumber(result.Text)
				if (v != "") && (StrLen(v) >= 4)
					reads.Push(v), reads.Push(v) ; counts double: these reads are much cleaner than the wide ones
				readLog .= tv[1] " x" scale ": " StrReplace(result.Text, "`n", " / ") "  ->  " ((v != "") ? v : "-") "`n"
			}
			Gdip_DisposeImage(pPad)
		}
		Gdip_DisposeImage(pTight)
	}
	else
		readLog .= "tight crop: Honey label not found`n"
	for variant in variants
	{
		for scale in variant[3]
		{
			for invert in variant[4]
			{
				if !(result := nm_OCR_FromBitmap(variant[1], scale, invert))
					continue
				v := HoneyFromOCR(result, w)
				if (v != "")
					reads.Push(v)
				readLog .= variant[2] " x" scale (invert ? " inverted" : "") ": " StrReplace(result.Text, "`n", " / ") "  ->  " ((v != "") ? v : "-") "`n"
			}
		}
	}
	Loop 3
		Gdip_DisposeImage(variants[2 + A_Index][1])

	; long counters (19 digits at 6 Qa) are rarely read identically twice, so if no two reads agree exactly,
	; build the number digit by digit from the reads of the most common length (needs 3+ such reads)
	best := HoneyConsensus(reads)
	if (best = "")
	{
		nm_OCR_SaveDebug(pBM, 0, "honey_fail")
		try {
			f := FileOpen(nm_OCR_RootDir() "\tools\OCR_debug\honey_fail.txt", "a")
			f.Write("`nArea: x" x0 " y" y0 " " w "x" h " (offset " offsetY ")`n" readLog), f.Close()
		}
	}
	; one line per minute in tools\OCR_debug\honey_log.txt
	try {
		logPath := nm_OCR_RootDir() "\tools\OCR_debug\honey_log.txt"
		DirCreate nm_OCR_RootDir() "\tools\OCR_debug"
		if (FileExist(logPath) && FileGetSize(logPath) > 50000)
			FileDelete logPath
		FileAppend FormatTime(, "HH:mm:ss") "  " ((best != "") ? best : "no reading") "  (" reads.Length " readings)`n", logPath
	}
	; integers top out at 9,223,372,036,854,775,807 (~9.2 Qa); only larger values are kept as a float
	if (best != "")
		honey_read_source := "ocr", honey_read_digits := best
	best := (best = "") ? 0 : ((StrLen(best) > 19) || (StrLen(best) = 19 && StrCompare(best, "9223372036854775807") > 0)) ? Float(best) : Integer(best)
	Gdip_DisposeImage(pBM), Gdip_DisposeImage(pBMc)
	return best
}

; finds the "Honey" label in the honey read area with OCR; returns its word box or 0
HoneyLabel(pBM, quick := 0)
{
	; the label's position is remembered: OCR sometimes misses the word even though nothing has moved, and
	; without the label the digit pictures can't be used at all. The remembered position is only reused for
	; a read area of the same size (same window size)
	static last := 0, lastSize := ""
	size := Gdip_GetImageWidth(pBM) "x" Gdip_GetImageHeight(pBM)
	if quick ; quick reads (every 12 s) use the remembered position only, never OCR
		return (last && size = lastSize) ? last : 0
	if (result := nm_OCR_FromBitmap(pBM, 3, 0)) && (word := HoneyTopLabel(result))
	{
		last := {x: word.x, y: word.y, w: word.w, h: word.h}, lastSize := size
		return last
	}
	return (last && size = lastSize) ? last : 0
}

; The topmost word that reads "Honey" in an OCR result, or 0. The counter's label is always the highest one,
; but BSS can show other text with "Honey" in it under the bar (the "...To Make Honey." hive prompt). Taking
; the first match sometimes picked the prompt's word: no digits right of it, so the read failed, and the
; wrong position was remembered for the 12 s quick reads too (runs of "no reading" while at the hive)
HoneyTopLabel(result)
{
	label := 0
	for word in result.Words
		if (nm_OCR_MatchDistance("honey", nm_OCR_Norm(word.Text)) <= 1) && (!label || word.y < label.y - 4)
			label := word
	return label
}

